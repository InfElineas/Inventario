# Copia este archivo a `.env` y rellena los valores. El `.env` no se versiona.
# Todo lo lee el SERVIDOR en runtime; el navegador no recibe ninguna variable.

# ── Identity Server de Elineas ─────────────────────────────────
# URL base del IS, alcanzable desde este servidor.
AUTH_API_URL=https://apiauth.mercadoelineas.com
# Slug del sistema registrado en el IS. Los usuarios necesitan al menos un rol
# en él; sin rol, el login responde 403.
SYSTEM_SLUG=inventario

# ── Login con Google (vía IS) ──────────────────────────────────
# URL del IS tal como la ve el NAVEGADOR (puede diferir de AUTH_API_URL si el
# servidor lo alcanza por una dirección interna). Si no se define, se usa
# AUTH_API_URL.
# AUTH_PUBLIC_URL=https://apiauth.mercadoelineas.com
# Origen público de ESTA app. Debe estar en GOOGLE_REDIRECT_ORIGINS del IS.
APP_URL=https://inv.mercadoelineas.com

# ── ELINEAS_BD ─────────────────────────────────────────────────
# Siempre como elineas_backend_app (solo DML), nunca como elineasadmin. Host =
# nombre del contenedor en la red elineas_default.
DATABASE_URL=postgres://elineas_backend_app:CAMBIAR@ELINEAS_BD:5432/ELINEAS_BD

# ── TKC (catálogo y existencias) ───────────────────────────────
TKC_BASE=
TKC_USER=
TKC_PASS=

# ── Ajustes de aumento y disminución (API de elineas-transferencia) ──
# Base de la API, alcanzable desde este servidor (sin /api/v1).
TRANSFERENCIAS_API_URL=
# Clave de ESTA app que sella la cookie `tkc` con las credenciales de TKC de cada
# persona (el IS las entrega solo en el login). Genera una con:
#   openssl rand -base64 32
# Cambiarla no rompe nada: las cookies viejas dejan de abrirse y se pide entrar otra vez.
TKC_SECRET_KEY=
# Clave COMPARTIDA con elineas-transferencia (su TKC_HANDOFF_KEY): sella lo que
# viaja entre los dos servidores. Distinta de TKC_SECRET_KEY.
TKC_HANDOFF_KEY=
